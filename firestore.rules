rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer/escribir SU propio backup.
    // El id del documento es el email del usuario (backup/{email}).
    match /backup/{email} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == email;

      // Historial por año: backup/{email}/history/{year}
      match /history/{year} {
        allow read, write: if request.auth != null
                           && request.auth.token.email == email;
      }
    }

    // Todo lo demas queda denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}